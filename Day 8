### Fizz Buzz

for x in range(1,101): # Loops through numbers 1 to 100.
  if x % 3 == 0 and x % 5 == 0: # Check if the number is divisible by both 3 and 5.
    print("FizzBuzz")
  elif x % 3 == 0: #Check if divisible by 3
    print("Fizz") 
  elif x % 5 == 0: #Check if divisble by 5
    print("Buzz")
  else:
    print(x)
